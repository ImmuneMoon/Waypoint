# Auto detect text files and perform LF normalization
* text=auto
*.woff2 binary
*.ttf binary
# the bundled libraries are kept byte for byte on every checkout (tools/sinkcheck.js pins their SHA-256)
system/app/assets/vendor/*.js binary
# net.js and the parts split out of it are kept byte for byte, with their CRLF line endings. Git kept net.js so before this line only because it holds two control bytes; the line keeps it so if those bytes ever move into a part (tools/splitcheck.js holds the line of every root kept so and of its parts)
system/app/scripts/net.js -text
system/app/scripts/nethold.js -text
system/app/scripts/netattack.js -text
system/app/scripts/nettime.js -text
system/app/scripts/netlink.js -text
system/app/scripts/nettrade.js -text
system/app/scripts/netfog.js -text
system/app/scripts/netfight.js -text
