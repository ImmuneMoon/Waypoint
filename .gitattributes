# Auto detect text files and perform LF normalization
* text=auto
*.woff2 binary
*.ttf binary
# the bundled libraries are kept byte for byte on every checkout (tools/sinkcheck.js pins their SHA-256)
system/app/assets/vendor/*.js binary
# the parts split out of net.js are kept byte for byte, with their CRLF line endings, as net.js is (git keeps net.js so since it holds control bytes; tools/splitcheck.js holds the line)
system/app/scripts/nethold.js -text
